{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MC Link",
  "version": "0.3.5",
  "identifier": "com.cugo.mc-link",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MC Link",
        "width": 640,
        "height": 360,
        "decorations": false,
        "transparent": true,
        "center": true,
        "resizable": true,
        "minWidth": 640,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "copyright": "© 2026 棱镜Prism工作室",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
