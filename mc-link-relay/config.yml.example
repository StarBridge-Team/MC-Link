# MC-Link 中继服务器配置文件

# 中央服务器地址
central_server: "mk.aini2.cn:8878"

# 监听端口（默认: 57894）
relay_port: 57894

# 上报地址（可选，用于NAT穿透场景，格式: IP:端口）
# 不配置则自动检测本地IP
# report_address: "192.168.1.100:57894"

# 心跳间隔（秒，默认: 5）
heartbeat_interval: 5

# 延迟探测间隔（秒，默认: 300）
latency_check_interval: 300

# 中继探测间隔（秒，默认: 180）
probe_interval: 180

# 带宽限制（MB/s，可选，默认无限制，最低10 MB/s）
# bandwidth_limit_mbps: 100