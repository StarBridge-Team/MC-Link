{
  "name": "mc-link",
  "private": true,
  "version": "0.4.6",
  "type": "module",
  "author": "棱镜Prism工作室",
  "description": "MC Link - 我的世界联机工具",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "dev:assets": "cargo run --manifest-path assets-server/Cargo.toml -- --port 54789 --root assets-server",
    "dev:fe": "concurrently -n vite,assets -c blue,green \"vite\" \"pnpm dev:assets\"",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-build.mjs",
    "build:release": "node scripts/tauri-build.mjs build",
    "sync:assets": "node scripts/sync-assets.mjs",
    "signer:generate": "node scripts/gen-signer.mjs",
    "signer:sync": "node scripts/gen-signer.mjs --sync"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-opener": "^2",
    "@vue/shared": "^3.5.40",
    "bootstrap-icons": "^1.13.1",
    "clsx": "^2.1.1",
    "element-plus": "^2.13.7",
    "lucide-vue-next": "^1.0.0",
    "tailwind-merge": "^3.5.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.12",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@tauri-apps/cli": "^2.12.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.1.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  },
  "packageManager": "pnpm@10.14.0+sha1.85759954ad817d248e2fed7f789f046a24f0327d"
}
